#!/usr/bin/env bash
set -e

session_name="$1"
reason="${2:-initial}"

if [[ -z "$session_name" ]]; then
    session_name=$(tmux display -p "#{session_name}" 2>/dev/null || true)
fi

if [[ -z "$session_name" ]]; then
    exit 0
fi

pane=$(tmux show-option -t "$session_name" -qv @codex_hud_pane)
base_height=$(tmux show-option -t "$session_name" -qv @codex_hud_base_height)
height=$(tmux show-option -t "$session_name" -qv @codex_hud_height)

is_positive_int() {
    [[ "$1" =~ ^[0-9]+$ ]] && [[ "$1" -gt 0 ]]
}

parse_boolean_setting() {
    local name="$1"
    local raw="$2"
    local default_value="$3"

    if [[ -z "$raw" ]]; then
        echo "$default_value"
        return 0
    fi

    local lowered
    lowered=$(printf "%s" "$raw" | tr '[:upper:]' '[:lower:]')

    case "$lowered" in
        1|true|on|yes)
            echo "1"
            ;;
        0|false|off|no)
            echo "0"
            ;;
        *)
            echo "Error: $name must be one of: 1, 0, true, false, on, off, yes, no (got: $raw)" >&2
            return 1
            ;;
    esac
}

pane_exists_in_session() {
    local pane_id="$1"

    if [[ -z "$pane_id" ]]; then
        return 1
    fi

    tmux list-panes -t "$session_name" -F "#{pane_id}" 2>/dev/null | grep -Fx "$pane_id" >/dev/null
}

if [[ -z "$pane" ]]; then
    exit 0
fi

current=$(tmux display -p -t "$pane" "#{pane_height}" 2>/dev/null || true)
if [[ "$reason" == "pane-resized" ]]; then
    # Both this helper and the HUD publish @codex_hud_height before resizing.
    # A different height therefore comes from a user resize, not content fit.
    # Record it without undoing the drag or changing the selected pane.
    if is_positive_int "$current" && is_positive_int "$height" && [[ "$current" != "$height" ]]; then
        tmux set-option -t "$session_name" -q @codex_hud_manual_height "$current" \
            \; set-option -t "$session_name" -q @codex_hud_height "$current"
    fi
    exit 0
fi

if [[ -z "$base_height" ]]; then
    base_height="$height"
fi

if [[ -z "$base_height" ]]; then
    exit 0
fi

auto=$(tmux show-option -t "$session_name" -qv @codex_hud_auto)
adaptive=$(tmux show-option -t "$session_name" -qv @codex_hud_height_adaptive)
max_height=$(tmux show-option -t "$session_name" -qv @codex_hud_height_max)
min_height=$(tmux show-option -t "$session_name" -qv @codex_hud_height_min)
stored_main_pane=$(tmux show-option -t "$session_name" -qv @codex_hud_main_pane)

if [[ -z "$auto" ]]; then
    auto="${CODEX_HUD_HEIGHT_AUTO:-}"
fi
auto=$(parse_boolean_setting "CODEX_HUD_HEIGHT_AUTO" "$auto" "0") || exit 1
adaptive=$(parse_boolean_setting "@codex_hud_height_adaptive" "$adaptive" "0") || exit 1
if [[ -z "$max_height" ]]; then
    max_height="${CODEX_HUD_HEIGHT_MAX:-12}"
fi
if [[ -z "$min_height" ]]; then
    min_height="${CODEX_HUD_HEIGHT_MIN:-$base_height}"
fi

if ! is_positive_int "$min_height"; then
    min_height="$base_height"
fi
if ! is_positive_int "$max_height"; then
    max_height="12"
fi

window_height=$(tmux display -p -t "$pane" "#{window_height}" 2>/dev/null || true)
if [[ "$adaptive" == "1" ]] && is_positive_int "$window_height"; then
    base_height=$((window_height / 6))
    if [[ "$base_height" -lt 5 ]]; then
        base_height="5"
    fi
    if [[ "$base_height" -gt "$max_height" ]]; then
        base_height="$max_height"
    fi
fi

target="$base_height"

if [[ "$auto" != "0" ]]; then
    pane_width=$(tmux display -p -t "$pane" "#{pane_width}" 2>/dev/null || true)
    extra_lines=0
    if is_positive_int "$pane_width"; then
        if [[ "$pane_width" -lt 60 ]]; then
            extra_lines=3
        elif [[ "$pane_width" -lt 80 ]]; then
            extra_lines=2
        elif [[ "$pane_width" -lt 100 ]]; then
            extra_lines=1
        fi
    fi
    target=$((base_height + extra_lines))
    if [[ "$target" -lt "$min_height" ]]; then
        target="$min_height"
    fi
    if [[ "$target" -gt "$max_height" ]]; then
        target="$max_height"
    fi
fi

# The HUD publishes the rows its content needs (src/utils/height-fit.ts);
# in adaptive mode that is the target, clamped like every other, and the
# width extras above no longer apply because the rows were measured.
fit_height=$(tmux show-option -t "$session_name" -qv @codex_hud_fit_height)
if [[ "$adaptive" == "1" ]] && is_positive_int "$fit_height"; then
    target="$fit_height"
    if [[ "$target" -lt "$min_height" ]]; then
        target="$min_height"
    fi
    if [[ "$target" -gt "$max_height" ]]; then
        target="$max_height"
    fi
fi

# Keep a manual size across terminal resizes. The HUD clears this only when
# changed content resumes automatic fitting; physical window bounds still win.
manual_height=$(tmux show-option -t "$session_name" -qv @codex_hud_manual_height)
if is_positive_int "$manual_height"; then
    target="$manual_height"
fi

if is_positive_int "$window_height" && [[ "$target" -ge "$window_height" ]]; then
    target=$((window_height - 1))
fi
if [[ "$target" -lt 1 ]]; then
    target="1"
fi

main_pane=""
if pane_exists_in_session "$stored_main_pane"; then
    main_pane="$stored_main_pane"
fi
if [[ -z "$main_pane" ]]; then
    main_pane=$(tmux list-panes -t "$session_name" -F "#{pane_id}" 2>/dev/null | grep -v "^${pane}$" | head -n1 || true)
fi

if [[ -n "$main_pane" ]]; then
    main_pane_in_mode=$(tmux display -p -t "$main_pane" "#{pane_in_mode}" 2>/dev/null || true)
    if [[ "$main_pane_in_mode" == "1" ]]; then
        exit 0
    fi
fi

if [[ "$adaptive" == "1" ]]; then
    tmux set-option -t "$session_name" -q @codex_hud_base_height "$base_height"
fi
tmux set-option -t "$session_name" -q @codex_hud_height "$target"

if [[ -n "$current" && "$current" != "$target" ]]; then
    tmux resize-pane -t "$pane" -y "$target" 2>/dev/null || true
fi
