#!/usr/bin/env bash
#
# codex-hud - Wrapper script for Codex CLI with HUD display
# Launches Codex in a tmux session with a status bar pane
#
# Environment variables:
#   CODEX_HUD_POSITION - HUD pane position: bottom (default), top
#   CODEX_HUD_HEIGHT   - HUD pane height in lines (default: terminal height / 6, min 5, max 12)
#   CODEX_HUD_HEIGHT_AUTO - Auto-adjust height for narrow panes (default: 1 unless height is explicit)
#   CODEX_HUD_HEIGHT_MIN - Minimum HUD height when auto-adjusting (default: 5 adaptive, explicit height fixed)
#   CODEX_HUD_HEIGHT_MAX - Maximum HUD height when auto-adjusting (default: 12)
#   CODEX_HUD_AUTO_ATTACH - If set to true, auto-attach even when Codex args are provided
#   CODEX_HUD_NO_ATTACH - Deprecated: if set to true, do not attach to existing session
#   CODEX_HUD_ALTERNATE_SCREEN - Use alternate screen in codex pane (default: 0)
#   CODEX_HUD_MOUSE - Enable tmux mouse mode for this session (default: 1)
#   CODEX_HUD_BIND_TOGGLE - Install the server-wide Prefix+H toggle: auto (default: only while the key is unbound), 1, or 0
#   CODEX_HUD_HEIGHT_FIT - Let the HUD grow/shrink the pane to its content in adaptive mode (default: 1)
#   CODEX_HUD_CLEAR_SCROLLBACK - If set to 1, clears tmux scrollback on first render
#   CODEX_HUD_HISTORY_LIMIT - HUD pane scrollback lines (default: 10000)
#   CODEX_HUD_TOOL_DETAILS - Tool details: off, targets (default), or full
#   CODEX_HUD_ASCII - Use ASCII-only status glyphs (default: 0)
#

set -e

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HUD_DIR="$(dirname "$SCRIPT_DIR")"
HUD_HEIGHT="${CODEX_HUD_HEIGHT:-}"
HUD_HEIGHT_EXPLICIT="0"
if [[ -n "$HUD_HEIGHT" ]]; then
    HUD_HEIGHT_EXPLICIT="1"
fi
HUD_POSITION="${CODEX_HUD_POSITION:-bottom}"
ALIAS_MARKER="# codex-hud alias"
CODEX_CLI_PATH=""
FORCE_ATTACH="0"
FORCE_NEW_SESSION="0"
CONTROL_TARGET=""
CONTROL_ALL="0"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print error message and exit
error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

# Print warning message
warn() {
    echo -e "${YELLOW}Warning:${NC} $1" >&2
}

# Print info message
info() {
    echo -e "${GREEN}Info:${NC} $1"
}

# Print step message
step() {
    echo -e "${BLUE}==>${NC} $1"
}

# Check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

parse_boolean_setting() {
    local name="$1"
    local raw="$2"
    local default_value="$3"

    if [[ -z "$raw" ]]; then
        echo "$default_value"
        return 0
    fi

    local lowered
    lowered=$(printf "%s" "$raw" | tr '[:upper:]' '[:lower:]')

    case "$lowered" in
        1|true|on|yes)
            echo "1"
            ;;
        0|false|off|no)
            echo "0"
            ;;
        *)
            echo "Error: $name must be one of: 1, 0, true, false, on, off, yes, no (got: $raw)" >&2
            return 1
            ;;
    esac
}

node_version_supported() {
    node -e '
const [major, minor] = process.versions.node.split(".").map(Number);
process.exit(major > 20 || (major === 20 && minor >= 19) ? 0 : 1);
' >/dev/null 2>&1
}

resolve_attach_policy() {
    local has_codex_args="${1:-0}"
    local auto_attach
    local no_attach

    auto_attach=$(parse_boolean_setting "CODEX_HUD_AUTO_ATTACH" "${CODEX_HUD_AUTO_ATTACH:-}" "0") || return 1
    no_attach=$(parse_boolean_setting "CODEX_HUD_NO_ATTACH" "${CODEX_HUD_NO_ATTACH:-}" "0") || return 1

    if [[ "$FORCE_NEW_SESSION" == "1" ]]; then
        echo "new"
        return 0
    fi

    if [[ "$FORCE_ATTACH" == "1" ]]; then
        echo "attach"
        return 0
    fi

    if [[ "$no_attach" == "1" ]]; then
        warn "CODEX_HUD_NO_ATTACH is deprecated; use --new-session or unset CODEX_HUD_AUTO_ATTACH instead."
        echo "new"
        return 0
    fi

    if [[ "$auto_attach" == "1" ]]; then
        echo "attach"
        return 0
    fi

    if [[ "$has_codex_args" != "1" ]]; then
        echo "attach"
        return 0
    fi

    echo "new"
}

resolve_alternate_screen_setting() {
    parse_boolean_setting "CODEX_HUD_ALTERNATE_SCREEN" "${CODEX_HUD_ALTERNATE_SCREEN:-}" "0"
}

# Whether to install the Prefix+H toggle. tmux key tables are server-wide, so
# the binding used to be opt-in only — which left the one path that works
# without leaving the Codex pane switched off for everyone. Unset now means
# "install while the key is free": tmux binds nothing to H by default, and a
# key the user has taken is left alone. 1 and 0 keep their explicit meaning.
resolve_bind_toggle() {
    local raw="${CODEX_HUD_BIND_TOGGLE:-}"
    if [[ -z "$raw" || "$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')" == "auto" ]]; then
        if prefix_h_is_free; then
            echo "1"
        else
            echo "0"
        fi
        return 0
    fi
    parse_boolean_setting "CODEX_HUD_BIND_TOGGLE" "$raw" "0"
}

# tmux prints the binding for a bound key and `unknown key` (non-zero) for an
# unbound one; a binding of our own counts as free so a restart re-installs it.
prefix_h_is_free() {
    local existing
    existing=$(tmux list-keys -T prefix H 2>/dev/null || true)
    if [[ -z "$existing" ]]; then
        return 0
    fi
    [[ "$existing" == *codex_hud_pane* ]]
}

hash_cwd() {
    local cwd="$1"
    local hash=""
    if command_exists md5sum; then
        hash=$(printf "%s" "$cwd" | md5sum | awk '{print $1}')
    elif command_exists md5; then
        hash=$(printf "%s" "$cwd" | md5 -q 2>/dev/null || printf "%s" "$cwd" | md5 | awk '{print $NF}')
    elif command_exists shasum; then
        hash=$(printf "%s" "$cwd" | shasum -a 256 | awk '{print $1}')
    fi
    if [[ -n "$hash" ]]; then
        echo "${hash:0:8}"
    else
        echo "$$"
    fi
}

# Generate a shell-safe project component for readable session names.
session_project_slug() {
    local project_name
    project_name=$(basename "$1")
    if [[ "$project_name" == "/" || -z "$project_name" ]]; then
        project_name="root"
    fi

    project_name=$(printf "%s" "$project_name" \
        | LC_ALL=C tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//')
    if [[ -z "$project_name" ]]; then
        project_name="project"
    fi
    printf "%.32s" "$project_name"
}

# Keep the legacy hash-only prefix discoverable so sessions created before this
# update remain attachable and killable.
PROJECT_SLUG="$(session_project_slug "$PWD")"
SESSION_HASH="$(hash_cwd "$PWD")"
LEGACY_SESSION_PREFIX="codex-hud-${SESSION_HASH}"
SESSION_PREFIX="codex-hud-${PROJECT_SLUG}-${SESSION_HASH}"
SESSION_NAME="${SESSION_PREFIX}-$(date +%Y%m%d%H%M%S)-$$"

prepare_cmux_codex_hook_router() {
    [[ -n "${CMUX_SURFACE_ID:-}" && "${CMUX_CODEX_HOOKS_DISABLED:-}" != "1" ]] || return 0

    local hook_router="${CMUX_CODEX_HOOK_ROUTER:-${HOME:-/Users/zyb}/.cmux/hooks/cmux-live-tmux-context.sh}"
    [[ -x "$hook_router" && "$hook_router" != "$SCRIPT_DIR/codex-hud" ]] || return 0

    # Make every cmux wrapper invocation pass through the user-owned inject
    # guard, even when the launching shell still carries the app-bundled CLI.
    # Preserve one explicit real CLI so the router cannot recurse into itself.
    local current_bundled_cli="${CMUX_BUNDLED_CLI_PATH:-}"
    local current_real_cli="${CMUX_LIVE_TMUX_CONTEXT_REAL_CLI:-}"
    if [[ -z "$current_real_cli" || "$current_real_cli" == "$hook_router" || ! -x "$current_real_cli" ]]; then
        if [[ -n "$current_bundled_cli" && "$current_bundled_cli" != "$hook_router" && -x "$current_bundled_cli" ]]; then
            current_real_cli="$current_bundled_cli"
        elif [[ -x "/Applications/cmux.app/Contents/Resources/bin/cmux" ]]; then
            current_real_cli="/Applications/cmux.app/Contents/Resources/bin/cmux"
        fi
    fi
    if [[ -n "$current_real_cli" && "$current_real_cli" != "$hook_router" ]]; then
        export CMUX_LIVE_TMUX_CONTEXT_REAL_CLI="$current_real_cli"
    fi
    export CMUX_BUNDLED_CLI_PATH="$hook_router"
}

resolve_codex_cli() {
    prepare_cmux_codex_hook_router
    local cmux_shim="${CMUX_CODEX_WRAPPER_SHIM:-}"
    if [[ -n "$cmux_shim" ]]; then
        if [[ -x "$cmux_shim" && "$cmux_shim" != "$SCRIPT_DIR/codex-hud" ]]; then
            CODEX_CLI_PATH="$cmux_shim"
            return 0
        fi

        # cmux stores per-surface shims under the macOS temporary directory.
        # A long-lived terminal can retain that path after the file is cleaned,
        # so recover through the stable wrapper instead of silently losing all
        # lifecycle hooks by launching the raw Codex binary.
        local cmux_wrapper=""
        local cmux_candidate=""
        local cmux_wrapper_cli="${CMUX_LIVE_TMUX_CONTEXT_REAL_CLI:-${CMUX_BUNDLED_CLI_PATH:-}}"
        if [[ -n "$cmux_wrapper_cli" ]]; then
            cmux_candidate="$(dirname "$cmux_wrapper_cli")/cmux-codex-wrapper"
            if [[ -x "$cmux_candidate" ]]; then
                cmux_wrapper="$cmux_candidate"
            fi
        fi

        if [[ -z "$cmux_wrapper" ]]; then
            cmux_candidate="/Applications/cmux.app/Contents/Resources/bin/cmux-codex-wrapper"
            if [[ -x "$cmux_candidate" ]]; then
                cmux_wrapper="$cmux_candidate"
            fi
        fi

        if [[ -z "$cmux_wrapper" ]]; then
            local cmux_cli
            cmux_cli=$(command -v cmux 2>/dev/null || true)
            if [[ -n "$cmux_cli" ]]; then
                cmux_candidate="$(dirname "$cmux_cli")/cmux-codex-wrapper"
                if [[ -x "$cmux_candidate" ]]; then
                    cmux_wrapper="$cmux_candidate"
                fi
            fi
        fi

        if [[ -n "$cmux_wrapper" ]]; then
            warn "cmux Codex shim is unavailable at $cmux_shim; using stable wrapper: $cmux_wrapper"
            CODEX_CLI_PATH="$cmux_wrapper"
            return 0
        fi

        warn "cmux Codex shim is unavailable at $cmux_shim and no stable cmux-codex-wrapper was found; starting Codex without cmux lifecycle hooks"
    fi

    local path
    path=$(command -v codex 2>/dev/null || true)
    if [[ -z "$path" ]]; then
        error "codex CLI is not found in PATH.

Install Codex CLI from: https://github.com/openai/codex"
    fi
    if [[ "$path" == "$SCRIPT_DIR/codex-hud" ]]; then
        error "codex resolves to codex-hud wrapper. Fix your alias to point to the real codex CLI."
    fi
    CODEX_CLI_PATH="$path"
}

# Get zsh rc file location (respects ZDOTDIR when set)
get_zsh_rc_file() {
    if [[ -n "${ZDOTDIR:-}" ]]; then
        echo "$ZDOTDIR/.zshrc"
        return 0
    fi
    echo "$HOME/.zshrc"
}

# Get the RC file for the current shell
get_shell_rc_file() {
    local shell_name
    shell_name=$(basename "$SHELL")
    case "$shell_name" in
        bash)
            if [[ -f "$HOME/.bashrc" ]]; then
                echo "$HOME/.bashrc"
            elif [[ -f "$HOME/.bash_profile" ]]; then
                echo "$HOME/.bash_profile"
            else
                echo "$HOME/.bashrc"
            fi
            ;;
        zsh)
            get_zsh_rc_file
            ;;
        fish)
            echo "$HOME/.config/fish/config.fish"
            ;;
        *)
            echo ""
            ;;
    esac
}

# Detect OS and package manager
detect_os() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "macos"
    elif [[ -f /etc/debian_version ]]; then
        echo "debian"
    elif [[ -f /etc/redhat-release ]]; then
        echo "redhat"
    elif [[ -f /etc/arch-release ]]; then
        echo "arch"
    elif [[ -f /etc/alpine-release ]]; then
        echo "alpine"
    else
        echo "unknown"
    fi
}

# Install tmux automatically
install_tmux() {
    local os
    os=$(detect_os)
    
    step "Installing tmux..."
    
    case "$os" in
        macos)
            if command_exists brew; then
                brew install tmux
            else
                error "Homebrew not found. Please install Homebrew first: https://brew.sh"
            fi
            ;;
        debian)
            if command_exists sudo; then
                sudo apt-get update && sudo apt-get install -y tmux
            else
                apt-get update && apt-get install -y tmux
            fi
            ;;
        redhat)
            if command_exists sudo; then
                sudo yum install -y tmux || sudo dnf install -y tmux
            else
                yum install -y tmux || dnf install -y tmux
            fi
            ;;
        arch)
            if command_exists sudo; then
                sudo pacman -S --noconfirm tmux
            else
                pacman -S --noconfirm tmux
            fi
            ;;
        alpine)
            if command_exists sudo; then
                sudo apk add tmux
            else
                apk add tmux
            fi
            ;;
        *)
            error "Could not detect OS for automatic tmux installation.

Please install tmux manually:
  Linux (Debian/Ubuntu): sudo apt install tmux
  Linux (RHEL/CentOS):   sudo yum install tmux
  Linux (Arch):          sudo pacman -S tmux
  macOS:                 brew install tmux"
            ;;
    esac
    
    # Verify installation
    if command_exists tmux; then
        info "tmux installed successfully!"
    else
        error "tmux installation failed. Please install manually."
    fi
}

# Check dependencies (with auto-install for tmux)
check_dependencies() {
    # Check tmux - auto-install if missing
    if ! command_exists tmux; then
        warn "tmux is not installed."
        echo ""
        read -p "Would you like to install tmux automatically? [Y/n] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]] || [[ -z $REPLY ]]; then
            install_tmux
        else
            error "tmux is required for codex-hud. Please install it manually."
        fi
    fi
    
    resolve_codex_cli
    
    if ! command_exists node; then
        error "Node.js is required but not installed.

Install Node.js 20.19+ from: https://nodejs.org/"
    fi
    if ! node_version_supported; then
        error "Node.js 20.19+ is required by the installed watcher dependencies (found $(node --version))"
    fi
}

# Build the HUD renderer if needed
build_hud() {
    local dist_file="$HUD_DIR/dist/index.js"
    local needs_build="0"
    
    # Check if node_modules exists
    if [[ ! -d "$HUD_DIR/node_modules" ]]; then
        step "Installing dependencies..."
        (cd "$HUD_DIR" && npm install) || error "Failed to install dependencies"
    fi
    
    # Check if we need to build
    if [[ ! -f "$dist_file" ]]; then
        needs_build="1"
    elif find "$HUD_DIR/src" -type f \( -name '*.ts' -o -name '*.tsx' \) -newer "$dist_file" -print -quit | grep -q .; then
        needs_build="1"
    fi

    if [[ "$needs_build" == "1" ]]; then
        step "Building HUD renderer..."
        (cd "$HUD_DIR" && npm run build) || error "Failed to build HUD renderer"
    fi
}

# Get the current working directory for Codex
get_cwd() {
    pwd
}

# Get the first pane ID in the session
get_primary_pane_id() {
    local session_name="${1:-$SESSION_NAME}"
    tmux list-panes -t "$session_name" -F "#{pane_id}" 2>/dev/null | head -n1
}

# Return 0 if a pane belongs to a session
pane_exists_in_session() {
    local session_name="$1"
    local pane_id="$2"

    if [[ -z "$session_name" || -z "$pane_id" ]]; then
        return 1
    fi

    tmux list-panes -t "$session_name" -F "#{pane_id}" 2>/dev/null | grep -Fx "$pane_id" >/dev/null
}

# Get the main Codex pane ID for a session
get_main_pane_id_for_session() {
    local session_name="${1:-$SESSION_NAME}"
    local stored_main
    local hud_pane
    local fallback_main

    stored_main=$(tmux show-option -t "$session_name" -qv @codex_hud_main_pane)
    if pane_exists_in_session "$session_name" "$stored_main"; then
        echo "$stored_main"
        return 0
    fi

    hud_pane=$(tmux show-option -t "$session_name" -qv @codex_hud_pane)
    if [[ -n "$hud_pane" ]]; then
        fallback_main=$(tmux list-panes -t "$session_name" -F "#{pane_id}" 2>/dev/null | grep -v "^${hud_pane}$" | head -n1 || true)
        if [[ -n "$fallback_main" ]]; then
            echo "$fallback_main"
            return 0
        fi
    fi

    get_primary_pane_id "$session_name"
}

# Find the most recent existing session for this directory
find_existing_session() {
    local sessions
    local current
    local legacy

    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null || true)
    current=$(printf "%s\n" "$sessions" | grep "^${SESSION_PREFIX}-" | sort | tail -n1)
    if [[ -n "$current" ]]; then
        echo "$current"
        return 0
    fi

    legacy=$(printf "%s\n" "$sessions" | grep "^${LEGACY_SESSION_PREFIX}-" | sort | tail -n1)
    if [[ -n "$legacy" ]]; then
        echo "$legacy"
    fi
}

# Control commands must never infer a target from recency. An explicit pane
# is resolved on this server; session names must match exactly, not by prefix.
resolve_control_session() {
    local sessions current candidates count
    sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
    if [[ -n "$CONTROL_TARGET" ]]; then
        current="$CONTROL_TARGET"
        if [[ "$current" =~ ^%[0-9]+$ ]]; then
            current=$(tmux display-message -p -t "$CONTROL_TARGET" '#{session_name}' 2>/dev/null || true)
        fi
        if [[ "$current" == codex-hud-* ]] && printf '%s\n' "$sessions" | grep -Fxq -- "$current"; then
            printf '%s\n' "$current"
            return 0
        fi
        echo "Error: No exact codex-hud session or pane matches --target $CONTROL_TARGET" >&2
        return 1
    fi
    if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
        current=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)
        if [[ "$current" == codex-hud-* ]] && printf '%s\n' "$sessions" | grep -Fxq -- "$current"; then
            printf '%s\n' "$current"
            return 0
        fi
    fi
    candidates=$(printf '%s\n' "$sessions" | grep -E "^(${SESSION_PREFIX}|${LEGACY_SESSION_PREFIX})-" | sort || true)
    count=$(printf '%s\n' "$candidates" | grep -c . || true)
    if [[ "$count" == "1" ]]; then
        printf '%s\n' "$candidates"
    elif [[ "$count" == "0" ]]; then
        echo 'Error: No codex-hud session found for the current directory.' >&2
        return 1
    else
        echo 'Error: Multiple sessions in this directory; use --target <session-or-pane>:' >&2
        printf '%s\n' "$candidates" | sed 's/^/  /' >&2
        return 1
    fi
}

parse_control_args() {
    local command="$1"
    shift
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --target)
                [[ "$#" -ge 2 && -n "$2" && "$2" != --* ]] || error '--target requires a session name or pane ID'
                [[ -z "$CONTROL_TARGET" ]] || error '--target may only be specified once'
                CONTROL_TARGET="$2"
                shift
                ;;
            --all)
                [[ "$command" == --kill || "$command" == --reload ]] || error "$command does not support --all"
                CONTROL_ALL="1"
                ;;
            *) error "Unknown option for $command: $1" ;;
        esac
        shift
    done
    [[ "$CONTROL_ALL" != "1" || -z "$CONTROL_TARGET" ]] || error '--all and --target cannot be combined'
    return 0
}

set_fixed_hud_height() {
    local session_name="$1"
    local hud_pane_id="$2"
    local height="$3"
    local main_pane_id="${4:-}"
    local resize_helper="$SCRIPT_DIR/codex-hud-resize"

    if [[ -z "$session_name" || -z "$hud_pane_id" || -z "$height" ]]; then
        return 0
    fi

    local auto_setting
    local adaptive_setting
    local adaptive_policy_stored="0"
    local min_setting
    local max_setting

    if [[ "$HUD_HEIGHT_EXPLICIT" == "1" ]]; then
        adaptive_setting="0"
    else
        adaptive_setting=$(tmux show-option -t "$session_name" -qv @codex_hud_height_adaptive)
        if [[ -n "$adaptive_setting" ]]; then
            adaptive_policy_stored="1"
        else
            adaptive_setting="1"
        fi
    fi
    adaptive_setting=$(parse_boolean_setting "@codex_hud_height_adaptive" "$adaptive_setting" "1") || return 1

    auto_setting="${CODEX_HUD_HEIGHT_AUTO:-}"
    if [[ -z "$auto_setting" ]]; then
        if [[ "$HUD_HEIGHT_EXPLICIT" == "1" ]]; then
            auto_setting="0"
        elif [[ "$adaptive_policy_stored" == "1" ]]; then
            auto_setting=$(tmux show-option -t "$session_name" -qv @codex_hud_auto)
        fi
    fi
    if [[ -z "$auto_setting" ]]; then
        auto_setting="1"
    fi
    auto_setting=$(parse_boolean_setting "CODEX_HUD_HEIGHT_AUTO" "$auto_setting" "1") || return 1

    min_setting="${CODEX_HUD_HEIGHT_MIN:-}"
    if [[ -z "$min_setting" ]]; then
        min_setting=$(tmux show-option -t "$session_name" -qv @codex_hud_height_min)
    fi
    if [[ -z "$min_setting" ]]; then
        if [[ "$adaptive_setting" == "1" ]]; then
            min_setting="5"
        else
            min_setting="$height"
        fi
    fi

    max_setting="${CODEX_HUD_HEIGHT_MAX:-}"
    if [[ -z "$max_setting" ]]; then
        max_setting=$(tmux show-option -t "$session_name" -qv @codex_hud_height_max)
    fi
    if [[ -z "$max_setting" ]]; then
        max_setting="12"
    fi

    local focus_main_setting
    focus_main_setting="1"

    tmux set-option -t "$session_name" -q @codex_hud_pane "$hud_pane_id" || return 1
    tmux set-option -t "$session_name" -q @codex_hud_auto "$auto_setting" || return 1
    tmux set-option -t "$session_name" -q @codex_hud_height_adaptive "$adaptive_setting" || return 1
    tmux set-option -t "$session_name" -q @codex_hud_height_min "$min_setting" || return 1
    tmux set-option -t "$session_name" -q @codex_hud_height_max "$max_setting" || return 1
    tmux set-option -t "$session_name" -q @codex_hud_base_height "$height" || return 1
    tmux set-option -t "$session_name" -q @codex_hud_height "$height" || return 1
    tmux set-option -t "$session_name" -q @codex_hud_focus_main "$focus_main_setting" || return 1
    if [[ -n "$main_pane_id" ]]; then
        tmux set-option -t "$session_name" -q @codex_hud_main_pane "$main_pane_id" || return 1
    fi

    if [[ -x "$resize_helper" ]]; then
        "$resize_helper" "$session_name" || true
    else
        tmux resize-pane -t "$hud_pane_id" -y "$height" 2>/dev/null || true
    fi

    local hook_cmd
    if [[ -x "$resize_helper" ]]; then
        hook_cmd="run-shell \"$resize_helper #{session_name}\""
        tmux set-hook -t "$session_name" client-resized "$hook_cmd" || true
        tmux set-hook -t "$session_name" after-resize-pane "$hook_cmd" || true
    fi
}

# Check if session already exists and is usable
check_existing_session() {
    local has_codex_args="${1:-0}"
    local attach_policy
    attach_policy=$(resolve_attach_policy "$has_codex_args") || exit 1
    if [[ "$attach_policy" != "attach" ]]; then
        return 1
    fi

    local existing
    existing=$(find_existing_session)
    if [[ -n "$existing" ]]; then
        SESSION_NAME="$existing"
        return 0
    fi
    return 1
}

# Cleanup function - only removes incomplete sessions during startup failures.
cleanup_incomplete_session() {
    local status="$?"

    if [[ "$status" -eq 0 ]]; then
        return 0
    fi

    local session_survives="0"
    if [[ "${SESSION_CREATED:-}" == "true" ]] && tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        session_survives="1"
    fi
    if [[ "${SESSION_CREATED:-}" == "true" && "${SESSION_CODEX_STARTED:-}" != "true" && "${SESSION_READY:-}" != "true" ]]; then
        if [[ "$session_survives" == "1" ]]; then
            tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true
            session_survives="0"
        fi
    fi
}

# Resolve HUD height based on terminal size
resolve_hud_height() {
    local term_height="$1"
    local requested="$HUD_HEIGHT"
    local min_height=5
    local max_height=$((term_height - 1))
    if [[ "$max_height" -lt 1 ]]; then
        max_height=1
    fi
    
    if [[ -n "$requested" ]]; then
        if ! [[ "$requested" =~ ^[0-9]+$ ]]; then
            error "CODEX_HUD_HEIGHT must be a positive integer (got: $requested)"
        fi
        if [[ "$requested" -gt "$max_height" ]]; then
            HUD_HEIGHT="$max_height"
            return 0
        fi
        if [[ "$requested" -lt 1 ]]; then
            HUD_HEIGHT="1"
            return 0
        fi
        HUD_HEIGHT="$requested"
        return 0
    fi
    
    local desired=$((term_height / 6))
    if [[ "$desired" -lt "$min_height" ]]; then
        desired="$min_height"
    fi
    if [[ "$desired" -gt 12 ]]; then
        desired="12"
    fi
    if [[ "$desired" -gt "$max_height" ]]; then
        desired="$max_height"
    fi
    if [[ "$desired" -lt 1 ]]; then
        desired="1"
    fi
    HUD_HEIGHT="$desired"
}

resolve_hud_height_for_tmux_target() {
    local target="$1"
    local term_height
    term_height=$(tmux display -p -t "$target" "#{window_height}" 2>/dev/null || true)
    if ! [[ "$term_height" =~ ^[0-9]+$ ]] || [[ "$term_height" -lt 1 ]]; then
        term_height=$(tput lines 2>/dev/null || echo 24)
    fi
    resolve_hud_height "$term_height"
}

# Environment variables the HUD renderer consumes. tmux panes inherit the
# *server's* environment, not the launching shell's, so every one of these
# must be baked into the pane command — verified live: with the tmux server
# running since the previous day, an exported CODEX_HUD_NOTIFY_CMD never
# reached the HUD process, and a server that happened to start with the
# variable pinned that value forever. Baked only when set and non-empty
# (empty means unset to every consumer, including NO_COLOR per its spec).
HUD_PASSTHROUGH_ENV_VARS=(
    CODEX_HUD_MODE
    CODEX_HUD_HEIGHT_FIT
    CODEX_HUD_TOOL_DETAILS
    CODEX_HUD_DETAILS
    CODEX_HUD_ASCII
    CODEX_HUD_LOG_FILE
    CODEX_HUD_NOTIFY_CMD
    CODEX_HUD_SHOW_OTHER_AGENT_SKILLS
    CODEX_HUD_AGENT_INACTIVITY_TIMEOUT_MS
    CODEX_HUD_CLEAR_SCROLLBACK
    NO_COLOR
)

# The HUD pane's launch command. Also rebuilt by --reload so a respawn bakes
# the caller's *current* environment instead of reviving values frozen at
# session creation. %q throughout: CODEX_HUD_NOTIFY_CMD in particular carries
# quotes and spaces, and a value with a single quote would cut a '...'-style
# interpolation in half.
build_hud_pane_command() {
    local cwd="$1"
    local main_pane_id="$2"
    local session_name="$3"
    local session_start="$4"
    local toggle_key="$5"
    local height="$6"
    local width="$7"
    local cwd_escaped
    cwd_escaped=$(printf "%q" "$cwd")
    # This branch's container filesystems need polling watchers; recomputed
    # here so --reload re-bakes the caller's current setting too.
    local use_polling
    use_polling=$(parse_boolean_setting "CHOKIDAR_USEPOLLING" "${CHOKIDAR_USEPOLLING:-}" "1") || return 1
    local env_parts=""
    local var
    for var in "${HUD_PASSTHROUGH_ENV_VARS[@]}"; do
        if [[ -n "${!var:-}" ]]; then
            env_parts+=" ${var}=$(printf "%q" "${!var}")"
        fi
    done
    printf '%s' "cd ${cwd_escaped} && exec env LINES='$height' COLUMNS='$width' CHOKIDAR_USEPOLLING='$use_polling' NODE_COMPILE_CACHE='$HUD_DIR/.cache/node-compile' CODEX_HUD_CWD=${cwd_escaped} CODEX_HUD_MAIN_PANE='$main_pane_id' CODEX_HUD_SESSION_START='$session_start' CODEX_HUD_TMUX_SESSION='$session_name' CODEX_HUD_TOGGLE_KEY='$toggle_key'${env_parts} node '$HUD_DIR/dist/index.js'"
}

# Create new tmux session with HUD
create_session() {
    local cwd="$1"
    shift
    local codex_args=("$@")
    local cwd_escaped
    local bind_toggle
    cwd_escaped=$(printf "%q" "$cwd")
    bind_toggle=$(resolve_bind_toggle) || return 1
    local hud_history_limit="${CODEX_HUD_HISTORY_LIMIT:-10000}"
    if ! [[ "$hud_history_limit" =~ ^[0-9]+$ ]] || [[ "$hud_history_limit" -lt 100 ]]; then
        error "CODEX_HUD_HISTORY_LIMIT must be an integer of at least 100 (got: $hud_history_limit)"
    fi
    
    # Calculate terminal dimensions
    local term_height
    local term_width
    term_height=$(tput lines 2>/dev/null || echo 24)
    term_width=$(tput cols 2>/dev/null || echo 80)
    resolve_hud_height "$term_height"
    
    # Build the codex command string
    local codex_cmd
    codex_cmd=$(printf "%q" "$CODEX_CLI_PATH")
    for arg in "${codex_args[@]}"; do
        codex_cmd="$codex_cmd $(printf "%q" "$arg")"
    done

    # respawn-pane starts Codex without typing its full launch command into the
    # user's terminal. Resolve and quote the shell that should take over after
    # Codex exits so the tmux session remains interactive and reconnectable.
    local resume_shell="${SHELL:-/bin/sh}"
    if [[ ! -f "$resume_shell" || ! -x "$resume_shell" ]]; then
        resume_shell="/bin/sh"
    fi
    local resume_shell_escaped
    resume_shell_escaped=$(printf "%q" "$resume_shell")
    
    # Create new detached session
    tmux new-session -d -s "$SESSION_NAME" -x "$term_width" -y "$term_height"
    SESSION_CREATED="true"
    # Keep wheel scrolling available in Codex pane by default.
    local mouse_setting
    mouse_setting=$(parse_boolean_setting "CODEX_HUD_MOUSE" "${CODEX_HUD_MOUSE:-}" "1") || exit 1

    if [[ "$mouse_setting" == "1" ]]; then
        tmux set-option -t "$SESSION_NAME" mouse on
        tmux set-option -t "$SESSION_NAME" wheel-scroll-lines 1 2>/dev/null || true
    else
        tmux set-option -t "$SESSION_NAME" mouse off
    fi

    tmux set-option -t "$SESSION_NAME" escape-time 0
    tmux set-option -t "$SESSION_NAME" assume-paste-time 0
    tmux set-option -t "$SESSION_NAME" repeat-time 0
    local inherited_history_limit
    inherited_history_limit=$(tmux show-option -t "$SESSION_NAME" -v history-limit 2>/dev/null || true)
    if [[ -z "$inherited_history_limit" ]]; then
        inherited_history_limit=$(tmux show-option -gv history-limit 2>/dev/null || true)
    fi
    if [[ -z "$inherited_history_limit" ]]; then
        inherited_history_limit="2000"
    fi
    # The main pane already exists. Temporarily lower the inherited value for
    # the HUD split, then restore it for any panes the user creates later.
    tmux set-option -t "$SESSION_NAME" history-limit "$hud_history_limit"

    local alternate_screen
    alternate_screen=$(resolve_alternate_screen_setting) || exit 1
    if [[ "$alternate_screen" == "1" ]]; then
        tmux set-window-option -t "$SESSION_NAME" alternate-screen on
    else
        tmux set-window-option -t "$SESSION_NAME" alternate-screen off
    fi
    local main_pane_id
    main_pane_id=$(get_primary_pane_id)
    if [[ -z "$main_pane_id" ]]; then
        error "Failed to detect tmux pane for session: $SESSION_NAME"
    fi
    
    # Codex probes the terminal during startup. Prefer starting it only after a
    # tmux client attaches so terminal replies are not delivered to the shell.
    # The gate is bounded (~10 seconds) and fails open. Gate setup itself is
    # noncritical: older/unusual tmux builds still launch Codex immediately.
    local attach_gate_cmd=""
    if tmux set-option -t "$SESSION_NAME" -q @codex_hud_client_attached 0 && \
       tmux set-hook -t "$SESSION_NAME" client-attached "set-option -t '$SESSION_NAME' -q @codex_hud_client_attached 1"; then
        attach_gate_cmd="i=0; while [ \"\$(tmux show-option -t '$SESSION_NAME' -qv @codex_hud_client_attached)\" != \"1\" ] && [ \"\$i\" -lt 200 ]; do sleep 0.05; i=\$((i+1)); done; "
    else
        warn "Unable to install tmux client-attach gate; starting Codex without it."
    fi

    # Start Codex as the pane process instead of injecting the launch command
    # into an interactive shell with send-keys, which would echo it before the
    # TUI appears. A non-zero Codex exit must still resume the user's shell; do
    # not append kill-session because detach/terminal-close sessions are reusable.
    local codex_launch_cmd
    codex_launch_cmd="${attach_gate_cmd}cd ${cwd_escaped} && $codex_cmd || :; exec $resume_shell_escaped"
    tmux respawn-pane -k -t "$main_pane_id" "$codex_launch_cmd"
    SESSION_CODEX_STARTED="true"
    
    # Wait a moment for the session to be ready
    sleep 0.2
    
    # Split the window based on HUD_POSITION
    local session_start
    session_start=$(date +%s)
    # The on-screen hint is the only place the hotkeys are taught, so tell the
    # HUD which one this session actually has: with Prefix+H installed the
    # toggle works from the Codex pane, without it the HUD pane must be
    # focused first and the hint has to say so.
    local toggle_key=""
    if [[ "$bind_toggle" == "1" ]]; then
        toggle_key="Prefix+H"
    fi
    # exec makes pane_pid the Node renderer itself, so --toggle-mode can signal
    # one exact HUD process without walking or guessing the process tree.
    # NODE_COMPILE_CACHE persists V8 code caches across HUD restarts (Node 22+;
    # older releases ignore the variable), shaving module compilation off the
    # time to first frame.
    local hud_cmd
    hud_cmd=$(build_hud_pane_command "$cwd" "$main_pane_id" "$SESSION_NAME" "$session_start" "$toggle_key" "$HUD_HEIGHT" "$term_width")
    # --reload rebuilds the pane command from these instead of reviving the
    # original one, so a respawn bakes the caller's current environment.
    tmux set-option -t "$SESSION_NAME" -q @codex_hud_cwd "$cwd"
    tmux set-option -t "$SESSION_NAME" -q @codex_hud_session_start "$session_start"
    tmux set-option -t "$SESSION_NAME" -q @codex_hud_toggle_key "$toggle_key"
    
    if [[ "$HUD_POSITION" == "top" ]]; then
        # Split at top, then swap panes
        local hud_pane_id
        hud_pane_id=$(tmux split-window -v -t "$SESSION_NAME" -l "$HUD_HEIGHT" -b -P -F "#{pane_id}" "$hud_cmd")
        tmux select-pane -t "$main_pane_id"
    else
        # Default: bottom
        local hud_pane_id
        hud_pane_id=$(tmux split-window -v -t "$SESSION_NAME" -l "$HUD_HEIGHT" -P -F "#{pane_id}" "$hud_cmd")
        tmux select-pane -t "$main_pane_id"
    fi
    tmux set-option -t "$SESSION_NAME" history-limit "$inherited_history_limit"

    if [[ -n "${hud_pane_id:-}" ]]; then
        set_fixed_hud_height "$SESSION_NAME" "$hud_pane_id" "$HUD_HEIGHT" "$main_pane_id"
        # Keep the pane around when the HUD exits (Ctrl+C, crash) so
        # `codex-hud --reload` can revive it with respawn-pane instead of the
        # layout collapsing. Pane-scoped options need tmux >= 3.0; older
        # releases keep the historical close-on-exit behavior.
        tmux set-option -p -t "$hud_pane_id" remain-on-exit on 2>/dev/null || true
    fi

    # tmux key tables are server-wide. Preserve unrelated sessions unless the
    # user explicitly opts into the legacy Prefix+H binding.
    if [[ "$bind_toggle" == "1" ]]; then
        tmux bind-key -T prefix H run-shell "tmux if-shell -F '#{@codex_hud_pane}' 'tmux send-keys -t #{@codex_hud_pane} C-t' ''" || true
    fi
    
    SESSION_READY="true"
}

# Codex subcommands that do not open an interactive session.
#
# The installer aliases `codex` to this wrapper, so every one of these used to
# be answered by starting a tmux session instead: `codex exec "..." > out.txt`
# wrote nothing and left a detached Codex running, `codex completion zsh`
# produced no script, and `codex --version` opened a HUD. They are forwarded to
# the real CLI in place, which is what the wrapper already does when it is
# invoked from inside a codex-hud session.
#
# `resume` and `fork` are deliberately absent: both open an interactive session
# and are worth a HUD (the installed `codex-resume` alias depends on it).
is_passthrough_command() {
    case "$1" in
        exec|e|review|login|logout|mcp|plugin|mcp-server|app-server|exec-server|\
        remote-control|app|completion|update|doctor|sandbox|debug|apply|a|\
        archive|delete|unarchive|cloud|features|help|--version|-V|\
        agents|queue|migrate-rollouts)
            # The last three arrived with codex 0.149: `queue` and
            # `migrate-rollouts` are plain CLI commands whose output belongs
            # on the caller's stdout, and `agents` is a browse TUI over the
            # app-server daemon, not a Codex session worth a HUD.
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Main function
main() {
    local codex_args=()

    # Parse wrapper arguments and pass the rest to codex CLI.
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --attach)
                FORCE_ATTACH="1"
                ;;
            --new-session)
                FORCE_NEW_SESSION="1"
                ;;
            --)
                shift
                codex_args+=("$@")
                break
                ;;
            *)
                codex_args+=("$1")
                ;;
        esac
        shift
    done

    # Already inside a codex-hud tmux session (e.g. `codex resume ...` typed in
    # the codex pane after exit, with the shell alias active): run the real
    # codex CLI in place instead of nesting another tmux session. The existing
    # HUD pane rebinds to the resumed/new session automatically.
    if [[ -n "${TMUX:-}" ]]; then
        local current_tmux_session
        current_tmux_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
        if [[ "$current_tmux_session" == codex-hud-* ]]; then
            resolve_codex_cli
            exec "$CODEX_CLI_PATH" "${codex_args[@]}"
        fi
    fi

    # A non-interactive Codex subcommand belongs to the CLI, not to a HUD:
    # hosting it in a tmux pane detaches its output from the caller's stdout.
    if [[ "${#codex_args[@]}" -gt 0 ]] && is_passthrough_command "${codex_args[0]}"; then
        resolve_codex_cli
        exec "$CODEX_CLI_PATH" "${codex_args[@]}"
    fi

    # Check dependencies
    check_dependencies
    
    # Build HUD if needed
    build_hud
    
    # Get current working directory
    local cwd
    cwd=$(get_cwd)
    
    local has_codex_args="0"
    if [[ "${#codex_args[@]}" -gt 0 ]]; then
        has_codex_args="1"
    fi

    # Check for existing session
    if check_existing_session "$has_codex_args"; then
        info "Attaching to existing session: $SESSION_NAME"
        local main_pane_id
        main_pane_id=$(get_main_pane_id_for_session "$SESSION_NAME")
        if [[ -n "$main_pane_id" ]]; then
            tmux select-pane -t "$main_pane_id" 2>/dev/null || true
        fi
        local hud_pane_id
        hud_pane_id=$(tmux show-option -t "$SESSION_NAME" -qv @codex_hud_pane)
        if [[ -n "$hud_pane_id" ]]; then
            resolve_hud_height_for_tmux_target "$hud_pane_id"
            set_fixed_hud_height "$SESSION_NAME" "$hud_pane_id" "$HUD_HEIGHT" "$main_pane_id"
        fi
        tmux attach-session -t "$SESSION_NAME"
        return 0
    fi
    
    # Set up cleanup trap
    trap cleanup_incomplete_session EXIT
    
    # Create new session
    info "Starting Codex with HUD (session: $SESSION_NAME)..."
    create_session "$cwd" "${codex_args[@]}"
    
    # Attach to the session
    local main_pane_id
    main_pane_id=$(get_main_pane_id_for_session "$SESSION_NAME")
    if [[ -n "$main_pane_id" ]]; then
        tmux select-pane -t "$main_pane_id" 2>/dev/null || true
    fi
    tmux attach-session -t "$SESSION_NAME"
}

# Show help
show_help() {
    cat << EOF
codex-hud - Codex CLI with HUD display

Usage: codex-hud [options] [codex options...]

This wrapper launches Codex in a tmux session with a real-time status bar
showing model info, git status, project info, token usage, and more.

A prompt and the interactive flags start a session with a HUD. Codex
subcommands that do not open a session (exec, login, mcp, completion, apply,
doctor, update, --version, ...) run in place and keep their stdout, so they
still work in pipes and scripts. Use 'codex help' for the Codex CLI's own help;
'--help' below documents this wrapper.

Options:
  -h, --help          Show this help message
  --self-check        Run environment diagnostics (includes recent HUD log entries)
  --doctor            Alias for --self-check
  --kill [--all]      Kill the current/unique session (--all: every session in this directory)
  --list              List all codex-hud sessions
  --reload [--all]    Restart the current/unique HUD pane (--all: every session in this directory)
  --toggle-mode       Toggle single/overview without focusing the HUD pane
  --cycle-details     Cycle tool details (targets -> full -> off) without focusing the HUD pane
  --target NAME|%ID   Select an exact session or pane for a control command
  --hud-version       Show HUD package version and checkout revision
  --attach            Attach to latest existing session in this directory
  --new-session       Always create a new session for this launch

HUD Pane Mouse and Keys:
  Click [view]        Toggle single/overview; clicks on content only focus the pane
  d (HUD focused)     Toggle compact/full HUD details (independent of tool details)
  Prefix+H            Toggle the view from the Codex pane (installed while the
                      key is unbound; CODEX_HUD_BIND_TOGGLE=0 skips, 1 forces)
  Ctrl+T / t          The same two actions from the keyboard once the pane is focused
  Ctrl+C              Close the HUD pane process
  The HUD reports mouse events itself, so the wheel no longer drops the pane
  into tmux copy-mode (which froze the view on its last frame).

Environment Variables:
  HUD display variables are captured from your shell when a session starts and
  re-captured by 'codex-hud --reload' — a running HUD never sees a later
  'export' on its own, because tmux panes inherit the tmux server's
  environment, not your shell's.

  CODEX_HUD_POSITION  HUD pane position: bottom (default), top
  CODEX_HUD_HEIGHT    HUD pane height in lines (default: terminal height / 6, min 5, max 12)
  CODEX_HUD_HEIGHT_AUTO Auto-adjust height for narrow panes (default: 1 unless height is explicit)
  CODEX_HUD_HEIGHT_MIN Minimum HUD height when auto-adjusting (default: 5 adaptive, explicit height fixed)
  CODEX_HUD_HEIGHT_MAX Maximum HUD height when auto-adjusting (default: 12)
  CODEX_HUD_HEIGHT_FIT In adaptive mode, let the HUD grow the pane to the rows its
                      content needs (up to HEIGHT_MAX, promptly) and shrink it
                      back after two quiet minutes (default: 1; explicit
                      CODEX_HUD_HEIGHT disables it)
  CODEX_HUD_AUTO_ATTACH Auto-attach even when Codex args are provided (default: 0)
  CODEX_HUD_NO_ATTACH Deprecated: force new session (overrides auto attach)
  CODEX_HUD_ALTERNATE_SCREEN Use alternate screen in codex pane (default: 0)
  CODEX_HUD_MOUSE Enable tmux mouse mode for this session (default: 1)
  CODEX_HUD_BIND_TOGGLE Server-wide Prefix+H toggle: unset/auto installs it while
                      the key is unbound, 1 always, 0 never
  CODEX_HUD_CLEAR_SCROLLBACK Clear terminal scrollback on first render (default: 0)
  CODEX_HUD_HISTORY_LIMIT HUD pane scrollback lines (default: 10000)
  CODEX_HUD_TOOL_DETAILS Tool details: off, targets (default), or full
  CODEX_HUD_DETAILS    HUD density: compact (default) or full; d toggles at runtime
  CODEX_HUD_LOG_FILE  Append HUD diagnostics to this file (default: ~/Library/Logs/codex-hud/hud.log
                      on macOS, \$XDG_STATE_HOME/codex-hud/hud.log elsewhere; 'off' discards them)
  CODEX_HUD_NOTIFY_CMD Shell command run when a session starts needing a human
                      (approval-needed / turn-interrupted / limit-reached) or
                      finishes a turn of three minutes or longer
                      (turn-completed, payload carries turnDurationMs);
                      event JSON on stdin and in CODEX_HUD_EVENT_JSON, the bare
                      name in CODEX_HUD_EVENT. Transitions only. (default: unset)
  CODEX_HUD_SHOW_OTHER_AGENT_SKILLS Show non-Codex .agents skill count (default: 0)
  CODEX_HUD_ASCII      Use ASCII status glyphs (default: 0)
  NO_COLOR             Disable ANSI colors when set

Requirements:
  - tmux (auto-installed if missing)
  - Node.js 20.19+
  - Codex CLI

Examples:
  codex-hud                    Start Codex with HUD
  codex-hud --model gpt-5      Start with specific model
  codex-hud "help me debug"    Start with initial prompt
  codex-hud --kill             Kill the current session (outside tmux: unique candidate)
  codex-hud --reload           Reload only the current/unique HUD pane
  codex-hud --reload --all     Reload the HUD pane of every session here
  codex-hud --toggle-mode      Toggle overview from the main shell
  codex-hud --cycle-details    Cycle tool details from the main shell
  codex-hud --attach            Reuse existing session intentionally
  codex-hud --new-session       Force a new session
  CODEX_HUD_POSITION=top codex-hud  HUD on top

For more information, see: https://github.com/openai/codex
EOF
}

# Run environment diagnostics
self_check() {
    local failures=0
    
    echo "Codex HUD self-check"
    echo ""
    
    if [[ -n "${ZDOTDIR:-}" ]] && [[ ! -d "$ZDOTDIR" ]]; then
        warn "ZDOTDIR is set but does not exist: $ZDOTDIR"
        failures=$((failures + 1))
    fi
    
    local codex_path
    codex_path=$(command -v codex 2>/dev/null || true)
    if [[ -n "$codex_path" ]]; then
        info "codex: $codex_path"
        if [[ "$codex_path" == "$SCRIPT_DIR/codex-hud" ]]; then
            warn "codex resolves to codex-hud wrapper; fix alias to the real codex CLI."
            failures=$((failures + 1))
        fi
    else
        warn "codex CLI not found in PATH"
        failures=$((failures + 1))
    fi
    
    if command_exists node; then
        info "node $(node --version)"
        if ! node_version_supported; then
            warn "Node.js 20.19+ is required by chokidar 5."
            failures=$((failures + 1))
        fi
    else
        warn "node not found in PATH"
        failures=$((failures + 1))
    fi
    
    if command_exists tmux; then
        info "tmux $(tmux -V)"
        local pane_index
        pane_index=$(tmux show-options -gqv pane-base-index)
        if [[ -n "$pane_index" && "$pane_index" != "0" ]]; then
            info "tmux pane-base-index=$pane_index (supported)"
        fi
    else
        warn "tmux not found in PATH"
        failures=$((failures + 1))
    fi
    
    local rc_file
    rc_file=$(get_shell_rc_file)
    if [[ -z "$rc_file" ]]; then
        warn "Unable to determine shell rc file for: $SHELL"
        failures=$((failures + 1))
    elif [[ ! -f "$rc_file" ]]; then
        warn "RC file not found: $rc_file"
        failures=$((failures + 1))
    elif grep -q "$ALIAS_MARKER" "$rc_file" 2>/dev/null; then
        info "Alias marker found in $rc_file"
    else
        warn "Alias marker not found in $rc_file"
        failures=$((failures + 1))
    fi
    
    # Not a failure: the hook is optional. But with it unset the states that
    # need a human (approval, a failed turn, a hit limit) stay on the pane
    # only, and a user working in another tmux window never hears of them.
    if [[ -n "${CODEX_HUD_NOTIFY_CMD:-}" ]]; then
        info "Notify hook configured (CODEX_HUD_NOTIFY_CMD)"
    else
        info "Notify hook not configured: set CODEX_HUD_NOTIFY_CMD to be paged for approval / failed-turn / limit events (see --help)"
    fi

    if [[ ! -f "$HUD_DIR/dist/index.js" ]]; then
        warn "HUD build output not found: $HUD_DIR/dist/index.js"
        failures=$((failures + 1))
    elif find "$HUD_DIR/src" -type f \( -name '*.ts' -o -name '*.tsx' \) \
        -newer "$HUD_DIR/dist/index.js" -print -quit | grep -q .; then
        warn "HUD build output is stale; run codex-hud --reload."
        failures=$((failures + 1))
    else
        info "HUD build output is current"
    fi

    # Render errors and uncaught exceptions land in the diagnostics log (see
    # src/utils/hud-log.ts for the resolution chain mirrored here), but until
    # now nothing displayed it — and this command is where users look first
    # when the HUD misbehaves. History is not a current fault, so log entries
    # never count as self-check failures.
    local log_file="${CODEX_HUD_LOG_FILE:-}"
    if [[ "$(printf '%s' "$log_file" | tr '[:upper:]' '[:lower:]')" == "off" ]]; then
        info "HUD diagnostics logging is disabled (CODEX_HUD_LOG_FILE=off)"
    else
        if [[ -z "$log_file" ]]; then
            local log_candidates=()
            if [[ "$OSTYPE" == darwin* ]]; then
                log_candidates+=("$HOME/Library/Logs/codex-hud/hud.log")
            fi
            if [[ -n "${XDG_STATE_HOME:-}" ]]; then
                log_candidates+=("$XDG_STATE_HOME/codex-hud/hud.log")
            else
                log_candidates+=("$HOME/.local/state/codex-hud/hud.log")
            fi
            log_candidates+=("${TMPDIR:-/tmp}/codex-hud/hud.log")
            local log_candidate
            log_file="${log_candidates[0]}"
            for log_candidate in "${log_candidates[@]}"; do
                if [[ -f "$log_candidate" ]]; then
                    log_file="$log_candidate"
                    break
                fi
            done
        fi
        if [[ -s "$log_file" ]]; then
            info "Recent HUD diagnostics ($log_file):"
            tail -n 5 "$log_file" | cut -c 1-300 | sed 's/^/    /'
        else
            info "No HUD diagnostics logged ($log_file)"
        fi
    fi

    if [[ "$failures" -gt 0 ]]; then
        warn "Self-check found $failures issue(s)."
        exit 1
    fi
    
    info "Self-check passed."
}

# --all is directory-scoped; otherwise use the same exact resolver as reload
# and view controls. A failed resolution must not reach a mutation.
kill_session() {
    local scope="${1:-current}"
    local sessions
    if [[ "$scope" == "all" ]]; then
        sessions=$(find_all_hud_sessions || true)
    else
        sessions=$(resolve_control_session) || return 1
    fi
    if [[ -z "$sessions" ]]; then
        warn "No session found: $SESSION_PREFIX or $LEGACY_SESSION_PREFIX"
        return
    fi
    while IFS= read -r session_name; do
        if [[ -n "$session_name" ]]; then
            tmux kill-session -t "$session_name"
            info "Killed session: $session_name"
        fi
    done <<< "$sessions"
    if [[ "$scope" != "all" ]]; then
        local remaining
        remaining=$(find_all_hud_sessions | grep -c . || true)
        if [[ "$remaining" -gt 0 ]]; then
            info "$remaining other session(s) in this directory kept; use --kill --all to remove them too."
        fi
    fi
}

# List all codex-hud sessions
# One line per session with the two things the name does not carry: which
# directory it is working in, and whether its HUD pane is still alive. With
# several sessions open the bare tmux listing differs only by timestamp and
# pid, which tells the user nothing about what they are looking at.
# Seconds since a process started, parsed from `ps -o etime=`. That column is
# locale-independent where `lstart` is not (this machine prints Chinese
# weekday names), and macOS ps has no `etimes`. Forms: mm:ss, hh:mm:ss,
# dd-hh:mm:ss.
elapsed_seconds() {
    local raw="$1" days=0 h m s
    [[ -n "$raw" ]] || return 1
    if [[ "$raw" == *-* ]]; then
        days="${raw%%-*}"
        raw="${raw#*-}"
    fi
    IFS=: read -r h m s <<< "$raw"
    if [[ -z "${s:-}" ]]; then
        s="$m"; m="$h"; h=0
    fi
    [[ "$days" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ && "$m" =~ ^[0-9]+$ && "$s" =~ ^[0-9]+$ ]] || return 1
    echo $(( ((10#$days * 24 + 10#$h) * 60 + 10#$m) * 60 + 10#$s ))
}

file_mtime_epoch() {
    stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

# A pane keeps running whatever build it was spawned with, so after a rebuild
# the sessions list is where "which HUDs predate dist?" gets answered. Any
# probe failure stays silent: an unmarked row means "not known stale", never
# "verified fresh".
hud_outdated_marker() {
    local pane_pid="$1" process_table="$2" dist_mtime="$3" now="$4"
    local process_row hud_pid raw_elapsed elapsed start_epoch
    [[ "$dist_mtime" =~ ^[0-9]+$ ]] || return 0
    process_row=$(printf '%s\n' "$process_table" | hud_process_from_table "$pane_pid") || return 0
    read -r hud_pid raw_elapsed <<< "$process_row"
    [[ "$hud_pid" =~ ^[0-9]+$ ]] || return 0
    elapsed=$(elapsed_seconds "$raw_elapsed") || return 0
    start_epoch=$(( now - elapsed ))
    # Two seconds of slack: a build and the spawn it precedes can share one.
    if (( dist_mtime > start_epoch + 2 )); then
        printf '  HUD: outdated (codex-hud --reload)'
    fi
}

list_sessions() {
    local rows panes name main_pane hud_pane attached cwd hud_state pane_pid
    local process_table dist_mtime now

    echo "Active codex-hud sessions:"
    rows=$(tmux list-sessions \
        -F "#{session_name}|#{@codex_hud_main_pane}|#{@codex_hud_pane}|#{?session_attached,attached,detached}" \
        2>/dev/null | grep "^codex-hud-") || rows=""
    if [[ -z "$rows" ]]; then
        echo "  (none)"
        return 0
    fi

    panes=$(tmux list-panes -a -F "#{pane_id}|#{?pane_dead,dead,live}|#{pane_pid}|#{pane_current_path}" 2>/dev/null) || panes=""
    # Launch/attach still prefers the newest session; controls resolve their
    # current pane or require an explicit target when the directory is shared.
    local newest_here
    newest_here=$(printf '%s\n' "$rows" | cut -d'|' -f1 | grep -E "^(${SESSION_PREFIX}|${LEGACY_SESSION_PREFIX})-" | sort | tail -n1)
    process_table=$(ps -axo pid=,ppid=,etime=,comm=,command= 2>/dev/null) || process_table=""
    dist_mtime=$(file_mtime_epoch "$HUD_DIR/dist/index.js") || dist_mtime=""
    now=$(date +%s)

    while IFS='|' read -r name main_pane hud_pane attached; do
        [[ -n "$name" ]] || continue
        # The path is the last field and may itself contain the separator, so
        # take everything after the first three fields rather than field four.
        cwd=$(printf '%s\n' "$panes" | awk -F'|' -v p="$main_pane" \
            '$1 == p { sub(/^[^|]*\|[^|]*\|[^|]*\|/, ""); print; exit }')
        if [[ -z "$cwd" ]]; then
            cwd="?"
        elif [[ "$cwd" == "$HOME"* ]]; then
            cwd="~${cwd#"$HOME"}"
        fi
        hud_state=$(printf '%s\n' "$panes" | awk -F'|' -v p="$hud_pane" '$1 == p { print $2; exit }')
        case "$hud_state" in
            live)
                pane_pid=$(printf '%s\n' "$panes" | awk -F'|' -v p="$hud_pane" '$1 == p { print $3; exit }')
                hud_state="$(hud_outdated_marker "$pane_pid" "$process_table" "$dist_mtime" "$now")"
                ;;
            dead) hud_state="  HUD: dead (codex-hud --reload)" ;;
            *)    hud_state="  HUD: missing" ;;
        esac
        local newest_marker=""
        if [[ -n "$newest_here" && "$name" == "$newest_here" ]]; then
            newest_marker="  (newest here: codex attach target)"
        fi
        printf '  %s  %s  [%s]%s%s\n' "$name" "$cwd" "$attached" "$hud_state" "$newest_marker"
    done <<< "$rows"
}

# Every codex-hud session for this directory, oldest first (current naming
# scheme plus the legacy prefix). find_existing_session keeps returning only
# the newest one.
find_all_hud_sessions() {
    tmux list-sessions -F "#{session_name}" 2>/dev/null \
        | grep -E "^(${SESSION_PREFIX}|${LEGACY_SESSION_PREFIX})-" \
        | sort
}

reload_hud_pane_for_session() {
    local session_name="$1"
    local hud_pane
    local main_pane
    hud_pane=$(tmux show-option -t "$session_name" -qv @codex_hud_pane) || return 1
    if ! pane_exists_in_session "$session_name" "$hud_pane"; then
        return 1
    fi
    main_pane=$(get_main_pane_id_for_session "$session_name") || return 1
    resolve_hud_height_for_tmux_target "$hud_pane" || return 1
    set_fixed_hud_height "$session_name" "$hud_pane" "$HUD_HEIGHT" "$main_pane" || return 1
    # Rebuild the pane command so the relaunch bakes the caller's *current*
    # environment (CODEX_HUD_NOTIFY_CMD and friends) instead of reviving the
    # values frozen at session creation. Sessions created by older wrappers
    # lack the stored fields and keep their original command.
    local stored_cwd
    local stored_start
    local stored_toggle
    local pane_width
    stored_cwd=$(tmux show-option -t "$session_name" -qv @codex_hud_cwd)
    stored_start=$(tmux show-option -t "$session_name" -qv @codex_hud_session_start)
    stored_toggle=$(tmux show-option -t "$session_name" -qv @codex_hud_toggle_key)
    if [[ -n "$stored_cwd" && -n "$stored_start" ]]; then
        pane_width=$(tmux display -p -t "$hud_pane" "#{pane_width}" 2>/dev/null || true)
        if ! [[ "$pane_width" =~ ^[0-9]+$ ]]; then
            pane_width=$(tput cols 2>/dev/null || echo 80)
        fi
        local pane_command
        pane_command=$(build_hud_pane_command "$stored_cwd" "$main_pane" "$session_name" "$stored_start" "$stored_toggle" "$HUD_HEIGHT" "$pane_width") || return 1
        tmux respawn-pane -k -t "$hud_pane" "$pane_command" || return 1
    else
        tmux respawn-pane -k -t "$hud_pane" || return 1
    fi
    if ! wait_for_hud_process "$session_name" "$hud_pane"; then
        warn "HUD did not stay running after respawn: $session_name ($hud_pane). Check codex-hud --self-check."
        return 1
    fi
    info "Reloaded HUD pane in session: $session_name"
}

reload_hud() {
    local session_name
    session_name=$(resolve_control_session) || return 1
    if [[ -z "$session_name" ]]; then
        error "No codex-hud session found for the current directory."
    fi
    build_hud
    if ! reload_hud_pane_for_session "$session_name"; then
        error "HUD reload failed in session: $session_name"
    fi
}

# Explicitly reload every HUD in this directory, preserving the main panes.
reload_hud_all() {
    local session_name
    local sessions
    local reloaded=0 failed=0
    sessions=$(find_all_hud_sessions || true)
    if [[ -z "$sessions" ]]; then
        error "No codex-hud session found for the current directory."
    fi
    build_hud
    while IFS= read -r session_name; do
        [[ -z "$session_name" ]] && continue
        if reload_hud_pane_for_session "$session_name"; then
            reloaded=$((reloaded + 1))
        else
            failed=$((failed + 1))
            warn "HUD reload failed in session: $session_name"
        fi
    done <<< "$sessions"
    info "HUD reload results: $reloaded succeeded, $failed failed."
    [[ "$failed" -eq 0 && "$reloaded" -gt 0 ]]
}

resolve_hud_node_pid() {
    local session_name="$1"
    local hud_pane="$2"
    local pane_pid
    pane_pid=$(tmux list-panes -t "$session_name" -F "#{pane_id} #{pane_pid}" 2>/dev/null \
        | awk -v target="$hud_pane" '$1 == target { print $2; exit }')
    if ! [[ "$pane_pid" =~ ^[0-9]+$ ]]; then
        return 1
    fi

    local process_row
    process_row=$(ps -axo pid=,ppid=,etime=,comm=,command= 2>/dev/null | hud_process_from_table "$pane_pid") || return 1
    [[ -n "$process_row" ]] || return 1
    printf '%s\n' "${process_row%% *}"
}

# Read one process snapshot (pid, ppid, etime, comm, command). Index children
# once, then visit only the pane's descendants. A fixed NR-by-NR scan made
# controls take seconds on a busy host even when the pane itself was Node.
hud_process_from_table() {
    [[ "$1" =~ ^[0-9]+$ ]] || return 1
    awk -v root="$1" '
        {
            pid = $1
            parent = $2
            elapsed[pid] = $3
            executable = $4
            sub(/^.*\//, "", executable)
            command_executable = $5
            sub(/^.*\//, "", command_executable)
            command = ""
            for (field = 5; field <= NF; field++) {
                command = command (field == 5 ? "" : " ") $field
            }
            is_hud[pid] = (executable == "node" || executable == "nodejs" || command_executable == "node" || command_executable == "nodejs") && command ~ /\/dist\/index[.]js([[:space:]]|$)/
            sibling[pid] = child[parent]
            child[parent] = pid
        }
        END {
            queue[1] = root
            tail = 1
            for (head = 1; head <= tail && head <= 256; head++) {
                pid = queue[head]
                if (seen[pid]++) continue
                if (is_hud[pid]) {
                    print pid, elapsed[pid]
                    exit
                }
                for (next_pid = child[pid]; next_pid != "" && tail < 256; next_pid = sibling[next_pid]) {
                    if (!seen[next_pid]) queue[++tail] = next_pid
                }
            }
        }
    '
}

# Respawn acceptance is not startup: an invalid entrypoint can exit at once.
# Require a live HUD Node process on two observations; never touch main panes.
wait_for_hud_process() {
    local session_name="$1" hud_pane="$2" previous_pid="" hud_pid dead
    local deadline=$((SECONDS + 8))
    while (( SECONDS < deadline )); do
        dead=$(tmux display-message -p -t "$hud_pane" '#{pane_dead}' 2>/dev/null) || return 1
        [[ "$dead" == 0 ]] || return 1
        hud_pid=$(resolve_hud_node_pid "$session_name" "$hud_pane") || hud_pid=""
        if [[ -n "$hud_pid" && "$hud_pid" == "$previous_pid" ]]; then
            return 0
        fi
        previous_pid="$hud_pid"
        sleep 0.1
    done
    return 1
}

# Deliver one signal to the resolved session's HUD process: USR1 toggles the
# view, USR2 cycles tool details — the `t` key without focusing the pane.
signal_hud() {
    local signal="$1"
    local verb="$2"
    local session_name
    local hud_pane
    local hud_pid
    session_name=$(resolve_control_session) || return 1
    if [[ -z "$session_name" ]]; then
        error "No codex-hud session found for the current directory."
    fi
    hud_pane=$(tmux show-option -t "$session_name" -qv @codex_hud_pane)
    if ! pane_exists_in_session "$session_name" "$hud_pane"; then
        error "HUD pane is unavailable in session: $session_name"
    fi
    hud_pid=$(resolve_hud_node_pid "$session_name" "$hud_pane" || true)
    if ! [[ "$hud_pid" =~ ^[0-9]+$ ]]; then
        error "Unable to resolve the HUD Node process for session: $session_name. Try codex-hud --reload."
    fi
    kill "-$signal" "$hud_pid"
    info "$verb in session: $session_name"
}

toggle_hud_mode() {
    signal_hud USR1 "Toggled HUD mode"
}

cycle_hud_details() {
    signal_hud USR2 "Cycled HUD tool details"
}

show_hud_version() {
    local version="unknown"
    local revision="unknown"
    if command_exists node && [[ -f "$HUD_DIR/package.json" ]]; then
        version=$(node -e 'const fs=require("fs"); const p=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); process.stdout.write(String(p.version || "unknown"));' "$HUD_DIR/package.json")
    fi
    if command_exists git; then
        revision=$(git -C "$HUD_DIR" rev-parse --short HEAD 2>/dev/null || printf "unknown")
    fi
    echo "codex-hud $version ($revision)"
}

# Check for special flags first
case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    --self-check|--doctor)
        self_check
        exit 0
        ;;
    --kill)
        parse_control_args "$@"
        # Need to check dependencies to ensure tmux is available
        if command_exists tmux; then
            if [[ "$CONTROL_ALL" == "1" ]]; then
                kill_session all
            else
                kill_session
            fi
        else
            error "tmux not installed"
        fi
        exit 0
        ;;
    --list)
        if command_exists tmux; then
            list_sessions
        else
            error "tmux not installed"
        fi
        exit 0
        ;;
    --reload)
        parse_control_args "$@"
        if command_exists tmux; then
            if ! command_exists node || ! node_version_supported; then
                error "Node.js 20.19+ is required to rebuild and reload the HUD."
            fi
            if [[ "$CONTROL_ALL" == "1" ]]; then
                reload_hud_all
            else
                reload_hud
            fi
        else
            error "tmux not installed"
        fi
        exit 0
        ;;
    --toggle-mode)
        parse_control_args "$@"
        if command_exists tmux; then
            toggle_hud_mode
        else
            error "tmux not installed"
        fi
        exit 0
        ;;
    --cycle-details)
        parse_control_args "$@"
        if command_exists tmux; then
            cycle_hud_details
        else
            error "tmux not installed"
        fi
        exit 0
        ;;
    --hud-version)
        show_hud_version
        exit 0
        ;;
esac

# Run main
main "$@"
